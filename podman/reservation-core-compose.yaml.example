# Skopiuj do lokalnego pliku (ignorowanego przez git):
#   cp podman/reservation-core-compose.yaml.example podman/reservation-core-compose.yaml
# Uruchom:
#   podman compose -f podman/reservation-core-compose.yaml up -d
# Stop:
#   podman compose -f podman/reservation-core-compose.yaml down
#
# Dane muszą być zgodne z src/main/resources/application.properties

services:
  postgres:
    image: docker.io/library/postgres:16-alpine
    container_name: reservation-postgres
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: reservation_core_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: root
    volumes:
      - ../postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d reservation_core_db"]
      interval: 5s
      timeout: 5s
      retries: 10
