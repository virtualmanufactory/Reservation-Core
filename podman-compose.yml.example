# Skopiuj do lokalnego pliku (ignorowanego przez git):
#   cp podman-compose.yml.example podman-compose.yml
# Uruchom:
#   podman compose -f podman-compose.yml up -d
# Stop:
#   podman compose -f podman-compose.yml down

services:
  postgres:
    image: docker.io/library/postgres:16-alpine
    container_name: reservation-postgres
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: reservation
      POSTGRES_USER: reservation
      POSTGRES_PASSWORD: reservation
    volumes:
      - ./postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U reservation -d reservation"]
      interval: 5s
      timeout: 5s
      retries: 10
